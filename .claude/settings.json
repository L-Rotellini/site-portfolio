{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pr-revues.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__.*create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pr-revues.sh\""
          }
        ]
      }
    ]
  }
}
